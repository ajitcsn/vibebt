# Local development: Vite proxies /api to this address.
VIBEBT_API_TARGET=http://127.0.0.1:8765

# Required when the cache is not a sibling directory of this repository.
# VIBEBT_KITE_CACHE=/absolute/path/to/kite-futures-cache

# Optional when Python is not at $VIBEBT_KITE_CACHE/.venv/bin/python.
# VIBEBT_PYTHON=/absolute/path/to/python

# Optional. Official NSE daily cash-equity import location.
# VIBEBT_NSE_DATA=/absolute/path/to/vibeBT/data/nse_daily

# Service controls. Keep the production API same-origin where possible.
# VIBEBT_HOST=127.0.0.1
# VIBEBT_PORT=8765
# VIBEBT_ALLOWED_ORIGINS=https://app.example.com
# VIBEBT_MAX_CONCURRENT_RUNS=2
# VIBEBT_MAX_REQUESTS_PER_MINUTE=30
# VIBEBT_LOG_LEVEL=INFO
